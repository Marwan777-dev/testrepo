<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nabadat.SurveyBuilder.IntegrationTests</RootNamespace>
    <AssemblyName>Nabadat.SurveyBuilder.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Testcontainers Postgres 16 + Elasticsearch 8.x back the module's end-to-end lane
       (Report/Analytics adapters read ES); WebApplicationFactory<Program> drives in-process HTTP. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="1.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="FluentAssertions" Version="6.12.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Testcontainers.Elasticsearch" Version="4.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <!-- Compute live TOTP codes from a seeded MFA secret so the factory can drive the real
         login → MFA verify → bearer-session flow (matches M-10 / M-06's OTP.NET). -->
    <PackageReference Include="OTP.NET" Version="1.*" />
  </ItemGroup>

  <!-- References the host (for WebApplicationFactory<Program>) and the module (for entity types +
       seeding helpers). The M-01 baseline SQL flows transitively to this project's output via the
       module reference once T008 adds it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nabadat.TenantAdmin\Nabadat.TenantAdmin.csproj" />
    <ProjectReference Include="..\..\src\Nabadat.SurveyBuilder\Nabadat.SurveyBuilder.csproj" />
  </ItemGroup>

</Project>
